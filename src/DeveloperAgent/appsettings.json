{
  "Agent": {
    "Name": "DeveloperAgent",
    "Model": "claude-opus-4-8",
    "Effort": "xhigh",
    "PersonaPath": "personas/developer.md",
    "PollIntervalSeconds": 60,
    "ReviewPollIntervalSeconds": 60,
    "FirstRetryIntervalSeconds": 2
  },
  "ScopeLimits": {
    "MaxChangedFiles": 50,
    "MaxChangedLines": 2000,
    "MaxExecutionTimeSeconds": 1800,
    "MaxModelTurns": 40,
    "MaxToolCalls": 200,
    "MaxRetryCount": 3,
    "MaxPRChangedFiles": 50,
    "MaxPRChangedLines": 2000
  },
  "Anthropic": {
    "ApiKeySecretName": "anthropic-api-key"
  },
  "HttpResilience": {
    "AttemptTimeoutSeconds": 60
  },
  "GitHub": {
    "Owner": "mchudinov",
    "Repository": { "Name": "TicTacToe2", "Url": "https://github.com/mchudinov/TicTacToe2", "DefaultBranch": "main" },
    "Project":    { "Name": "TicTacToe", "Number": 4, "OwnerType": "User" },
    "States":     { "Backlog": "Backlog", "Ready": "Ready", "InProgress": "In Progress", "InReview": "In Review", "Done": "Done" },
    "TokenSecretName": "github-token"
  },
  "Triage": {
    "Enabled": true,
    "RepoScope": "A C#/.NET application repository. In-scope work: implementing application features, fixing bugs, refactoring, and adding or updating automated tests within this codebase. Out of scope: tasks for other repositories, non-coding/administrative chores, questions, and anything requiring a language or platform this codebase does not use.",
    "AgentSkill": "A senior .NET 10 C# developer that implements coding tasks end-to-end (features, bug fixes, refactors, tests) and delivers them as a pull request."
  },
  "Workspace": {
    "RootPath": "/workspace",
    "AllowedCommands": [ "dotnet", "git", "gh", "ls", "dir", "pwd", "cat"]
  },
  "Sandbox": {
    "DenyPathPatterns": [ "~/.ssh/**", ".env*", ".git/config" ],
    "SecretFileRegexes": [],
    "DeniedCommands": [
      { "Name": "no-curl",            "Program": "curl" },
      { "Name": "no-wget",            "Program": "wget" },
      { "Name": "no-chmod-exec",      "Program": "chmod", "ArgPatterns": [ "+x" ] },
      { "Name": "no-git-force-push",  "Program": "git",   "ArgPatterns": [ "push", "--force" ] },
      { "Name": "no-git-force-push-short", "Program": "git", "ArgPatterns": [ "push", "-f" ] },
      { "Name": "no-git-force-with-lease", "Program": "git", "ArgPatterns": [ "push", "--force-with-lease" ] },
      { "Name": "no-gh-secret-set",    "Program": "gh",   "ArgPatterns": [ "secret", "set" ] },
      { "Name": "no-gh-secret-remove", "Program": "gh",   "ArgPatterns": [ "secret", "remove" ] },
      { "Name": "no-gh-secret-delete", "Program": "gh",   "ArgPatterns": [ "secret", "delete" ] },
      { "Name": "no-gh-branch-protection", "Program": "gh", "ArgPatterns": [ "api" ], "ArgContains": [ "protection" ] },
      { "Name": "no-gh-repo-delete",   "Program": "gh",   "ArgPatterns": [ "repo", "delete" ] },
      { "Name": "no-gh-auth",          "Program": "gh",   "ArgPatterns": [ "auth" ] },
      { "Name": "no-gh-api-delete-x",      "Program": "gh", "ArgPatterns": [ "api", "-X", "DELETE" ] },
      { "Name": "no-gh-api-delete-method", "Program": "gh", "ArgPatterns": [ "api", "--method", "DELETE" ] },
      { "Name": "no-gh-api-put-x",         "Program": "gh", "ArgPatterns": [ "api", "-X", "PUT" ] },
      { "Name": "no-gh-api-put-method",    "Program": "gh", "ArgPatterns": [ "api", "--method", "PUT" ] },
      { "Name": "no-gh-api-post-x",        "Program": "gh", "ArgPatterns": [ "api", "-X", "POST" ] },
      { "Name": "no-gh-api-post-method",   "Program": "gh", "ArgPatterns": [ "api", "--method", "POST" ] },
      { "Name": "no-dotnet-tool-install",  "Program": "dotnet", "ArgPatterns": [ "tool", "install" ] }
    ],
    "AllowedHosts": [
      "api.anthropic.com",
      "api.github.com",
      "*.githubusercontent.com",
      "context7.com"
    ]
  },
  "ContainerRuntime": {
    "Enabled": false,
    "Image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "MountPath": "/workspace",
    "Cpus": "2",
    "Memory": "2g",
    "NetworkMode": "none",
    "RuntimeExecutable": "docker"
  },
  "McpServers": {
    "Servers": {
      "GitHub": {
        "Enabled": false,
        "Command": "npx",
        "Arguments": [ "-y", "@modelcontextprotocol/server-github" ],
        "Env": {}
      },
      "Context7": {
        "Enabled": false,
        "Command": "npx",
        "Arguments": [ "-y", "@upstash/context7-mcp" ],
        "Env": {}
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Debug"
      }
    ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8089"
      }
    }
  }
}

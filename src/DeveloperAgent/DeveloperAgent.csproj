<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>e1885b1f-9a1f-40aa-bec9-b36a748f40d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Workflow" Version="1.17.9" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.8.0" />
    <PackageReference Include="Microsoft.Agents.AI.Anthropic" Version="1.1.0-rc1" />
    <!--
      Pin the Anthropic provider (transitively required by Microsoft.Agents.AI.Anthropic,
      which floors it at 12.11.0) up to 12.18.0+. Anthropic <= 12.16.0 was compiled against
      Microsoft.Extensions.AI.Abstractions 10.4.0, where WebSearchToolResultContent exposed a
      `Results` property; 10.5.x renamed it to `Outputs`. The rest of the graph (Microsoft.Agents.AI
      1.6.2, ModelContextProtocol.Core 1.3.0) forces Abstractions to 10.5.x, so older Anthropic
      builds threw MissingMethodException: get_Results() on every model call. 12.18.0 is the first
      release compiled against Abstractions 10.5.x (it reads `Outputs`).
    -->
    <PackageReference Include="Anthropic" Version="12.24.1" />
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Dapr.Actors" Version="1.17.9" />
    <PackageReference Include="Dapr.Actors.AspNetCore" Version="1.17.9" />
    <PackageReference Include="Dapr.Client" Version="1.17.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="Octokit.GraphQL" Version="0.4.0-beta" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeAgents.GitHub\ClaudeAgents.GitHub.csproj" />
    <ProjectReference Include="..\Library\Library.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Layout\" />
    <Folder Include="Components\Pages\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\personas\**\*.md" LinkBase="personas" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="dapr-components\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

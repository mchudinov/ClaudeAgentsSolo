<Project Sdk="Aspire.AppHost.Sdk/13.3.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>0d7358af-0024-4103-95d5-500bd581d26c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.2.1" />
    <PackageReference Include="AJP.Aspire.Hosting.AsbEmulatorUi" Version="1.0.24" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.2.1" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveloperAgent\DeveloperAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapr component CRDs (state store + resiliency). AppHost owns the Dapr
         wiring, so the component definitions live here; AppHost.cs resolves them
         from the source tree and the toolkit feeds them to the sidecar. Copied to
         output to ship with the build. -->
    <Content Include="dapr\components\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent-neutral command/file/egress security boundary: ICommandSandbox/CommandSandbox,
         command + path deny policies, HostAllowlistHandler (HTTP egress), IContainerRuntime/
         DockerContainerRuntime, SandboxViolationException, CommandResult/TaskWorkspace, and the
         ShellRunTool adapter. DelegatingHandler/Process come from the net10 shared framework;
         these packages cover Options binding, ILogger, the DI registration extension, and the
         named-HttpClient builder the host composes HostAllowlistHandler onto. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent.Tools OWNS IPathDenyPolicy (the path-deny seam); Agent.Sandbox depends on Tools for
         it. This keeps the dependency line Tools -> Sandbox -> Workspace a clean acyclic line.
         ShellRunTool (moved here) also consumes ITool/IToolContext/PathValidator/ToolResult from it. -->
    <ProjectReference Include="..\Agent.Tools\Agent.Tools.csproj" />
  </ItemGroup>

</Project>
